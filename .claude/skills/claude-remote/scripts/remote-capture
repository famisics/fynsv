#!/usr/bin/env bash
# Capture pane content.
#
#   remote-capture <target>         # last 200 lines
#   remote-capture -n 500 <target>  # last 500 lines

set -euo pipefail

_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# shellcheck source=lib/common.sh
source "$_BIN_DIR/lib/common.sh"
# shellcheck source=lib/parse-target.sh
source "$_BIN_DIR/lib/parse-target.sh"

lines=200
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) lines="$2"; shift 2 ;;
    --) shift; break ;;
    -*) die "unknown flag: $1" ;;
    *)  break ;;
  esac
done

remote_bootstrap "${1-}"
session_exists "$TARGET_SESSION" || die "session not found: $TARGET_SESSION"

tmux capture-pane -t "$TARGET_SESSION" -p -S "-${lines}"

! NEC Portable Internetwork Core Operating System Software
! IX Series IX2215 (magellan-sec) Software, Version 10.11.14, RELEASE SOFTWARE
! Compiled Jan 13-Tue-2026 17:16:30 JST #2
! Current time Apr 27-Mon-2026 12:42:15 JST
!
!
!
!
timezone +09 00
!
username famisics password hash <ADMIN_PASSWORD_HASH> administrator
!
!
ip route default GigaEthernet1.1
ip route default 10.0.0.2 GigaEthernet0.0 metric 200
ip route 192.168.2.0/24 10.0.0.2 GigaEthernet0.0
ip dhcp enable
!
!
ipv6 route default GigaEthernet1.0 ra
ipv6 dhcp enable
!
!
!
!
!
!
!
!
!
!
!
watch-group wan-failover 1
  event 1 ip reach-host 8.8.8.8 GigaEthernet1.1
  probe-mode traffic event 1
  action 1 ip shutdown-route 0.0.0.0/0 GigaEthernet1.1
  action 2 ip resume-route 0.0.0.0/0 GigaEthernet1.1
!
network-monitor wan-failover enable
network-monitor wan-failover startup-delay 180
!
!
ppp profile biglobe
  authentication myname <PPPOE_USERNAME>
  authentication password <PPPOE_PASSWORD> 0
  authentication password <PPPOE_USERNAME> <PPPOE_PASSWORD>
!
ip dhcp profile lan
  assignable-range 192.168.1.100 192.168.1.200
  default-gateway 192.168.1.1
  dns-server 8.8.8.8 8.8.4.4
!
device GigaEthernet0
!
device GigaEthernet1
!
device GigaEthernet2
!
device BRI0
  isdn switch-type hsd128k
!
device USB0
  no shutdown
!
interface GigaEthernet0.0
  ip address 10.0.0.1/30
  no shutdown
!
interface GigaEthernet1.0
  no ip address
  ipv6 enable
  ipv6 nd proxy GigaEthernet2.0
  no shutdown
!
interface GigaEthernet2.0
  ip address 192.168.1.1/24
  ip dhcp binding lan
  ipv6 enable
  ipv6 nd ra enable
  ipv6 nd ra dns-server 2001:4860:4860::8888 2001:4860:4860::8844 1800
  no shutdown
!
interface BRI0.0
  encapsulation ppp
  no auto-connect
  no ip address
  shutdown
!
interface USB-Serial0.0
  encapsulation ppp
  no auto-connect
  no ip address
  shutdown
!
interface GigaEthernet1.1
  encapsulation pppoe
  auto-connect
  ppp binding biglobe
  ip address ipcp
  ip tcp adjust-mss auto
  ip napt enable
  ipv6 enable
  no shutdown
!
interface Loopback0.0
  no ip address
!
interface Null0.0
  no ip address
!
interface Tunnel0.0
  tunnel mode map-e
  ip address map-e
  ip tcp adjust-mss auto
  ip napt enable
  shutdown
!

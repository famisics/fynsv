! NEC Portable Internetwork Core Operating System Software
! IX Series IX2215 (magellan-sec) Software, Version 10.11.14, RELEASE SOFTWARE
! Compiled Jan 13-Tue-2026 17:16:30 JST #2
! Current time Apr 27-Mon-2026 12:55:24 JST
!
!
!
!
timezone +09 00
!
username famisics password hash <ADMIN_PASSWORD_HASH> administrator
!
!
ip route default GigaEthernet1.0
ip route default 10.0.0.1 GigaEthernet0.0 metric 200
ip route 192.168.1.0/24 10.0.0.1 GigaEthernet0.0
ip dhcp enable
!
!
!
!
!
!
!
!
!
!
!
!
usbmem enable
!
!
!
watch-group wan-failover 1
  event 1 ip reach-host 1.1.1.1 GigaEthernet1.0
  probe-mode traffic event 1
  action 1 ip shutdown-route 0.0.0.0/0 GigaEthernet1.0
  action 2 ip resume-route 0.0.0.0/0 GigaEthernet1.0
!
network-monitor wan-failover enable
network-monitor wan-failover startup-delay 180
!
!
ip dhcp profile lan2
  assignable-range 192.168.2.100 192.168.2.200
  default-gateway 192.168.2.1
  dns-server 8.8.8.8 8.8.4.4
!
device GigaEthernet0
!
device GigaEthernet1
!
device GigaEthernet2
!
device BRI0
  isdn switch-type hsd128k
!
device USB0
  no shutdown
!
interface GigaEthernet0.0
  ip address 10.0.0.2/30
  no shutdown
!
interface GigaEthernet1.0
  ip address dhcp
  ip napt enable
  no shutdown
!
interface GigaEthernet2.0
  ip address 192.168.2.1/24
  ip dhcp binding lan2
  no shutdown
!
interface BRI0.0
  encapsulation ppp
  no auto-connect
  no ip address
  shutdown
!
interface USB-Serial0.0
  encapsulation ppp
  no auto-connect
  no ip address
  shutdown
!
interface Loopback0.0
  no ip address
!
interface Null0.0
  no ip address
!

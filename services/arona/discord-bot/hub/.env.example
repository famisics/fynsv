# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=your_bot_token_here
# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# Discord Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# 管理画面の公開 URL (末尾スラッシュなし)。OAuth2 の Redirect は <PUBLIC_URL>/auth/callback
PUBLIC_URL=https://hub.example.com
# 待ち受けポート (Nitro が読む。compose.yml の ports と揃える)
PORT=8091
# SQLite データベースファイルのパス (docker compose では /data/hub.db)
DB_PATH=/data/hub.db
# Misskey インスタンス (LAN 直結ならゲストの http URL)
MISSKEY_ORIGIN=
# 本人アカウント (@ なし)
MISSKEY_USER_ID=
# トークンは read:account が必要
MISSKEY_USER_TOKEN=

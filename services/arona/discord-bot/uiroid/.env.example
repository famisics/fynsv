# Discord bot のトークン (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_bot_token_here
# Misskey インスタンス (LAN 直結ならゲストの http URL)
MISSKEY_ORIGIN=
# 本人アカウント (@ なし)
MISSKEY_USER_ID=
# トークンは read:account が必要
MISSKEY_USER_TOKEN=
# SQLite データベースファイルのパス (docker compose では /data/uiroid.db)
DB_PATH=/data/uiroid.db

# Misskey インスタンス (LAN 直結ならゲストの http URL)
MISSKEY_ORIGIN=
# 切り詰め時に付与する元ノート URL のオリジン (公開 URL)
MISSKEY_PUBLIC_ORIGIN=
# 本人アカウント (@ なし)
MISSKEY_USER_ID=
# トークンは read:account が必要
MISSKEY_USER_TOKEN=
# bot のスクリーンネーム (@ なし / これをメンションした本人ノートだけ転送する)
MISSKEY_BOT_ID=
# トークンは write:notes / write:drive が必要
MISSKEY_BOT_TOKEN=
# mixi2 Developer Platform のクレデンシャル
MIXI2_CLIENT_ID=
MIXI2_CLIENT_SECRET=
# 本人のスクリーンネーム (@ なし)
MIXI2_USER_ID=
# bot のスクリーンネーム (@ なし / これをメンションした本人ノートだけ転送する)
MIXI2_BOT_ID=
# Turso の接続情報 (turso db show --url / turso db tokens create)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 1 にすると実投稿せず変換結果のログだけ出す
DRY_RUN=0

# このファイルを terraform.tfvars にコピーして実値を記入する。
# terraform.tfvars は .gitignore 済み (コミットされない)。

pve_endpoint  = "https://192.168.2.11:8006/"
pve_api_token = "terraform@pve!provider=00000000-0000-0000-0000-000000000000"
